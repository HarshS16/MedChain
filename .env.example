# ==============================================
# MedChain Environment Variables
# ==============================================
# Copy this file to .env and fill in the values

# ---- General ----
NODE_ENV=development
PORT=3001

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=24h

# ---- PostgreSQL ----
DATABASE_URL=postgresql://medchain:medchain_password@localhost:5432/medchain
POSTGRES_USER=medchain
POSTGRES_PASSWORD=medchain_password
POSTGRES_DB=medchain

# ---- Supabase (pgvector + auth) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ---- IPFS ----
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# ---- Hyperledger Fabric ----
FABRIC_NETWORK_PATH=../blockchain/network
FABRIC_CHANNEL_NAME=medchannel
FABRIC_CHAINCODE_NAME=medrecord
FABRIC_ORG1_MSP=HospitalAMSP
FABRIC_ORG2_MSP=HospitalBMSP
FABRIC_CA_URL=https://localhost:7054
FABRIC_ORDERER_URL=grpcs://localhost:7050
FABRIC_PEER_URL=grpcs://localhost:7051
FABRIC_WALLET_PATH=./wallet

# ---- AI Service ----
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=your-internal-ai-service-key

# ---- LLM APIs ----
ZHIPU_API_KEY=your-zhipu-glm4-api-key
GEMINI_API_KEY=your-google-gemini-api-key
LLM_PROVIDER=zhipu  # or 'gemini'
LLM_MODEL=glm-4

# ---- Encryption ----
ENCRYPTION_ALGORITHM=aes-256-gcm
KEY_DERIVATION_ITERATIONS=100000

# ---- ABDM/ABHA ----
ABDM_API_URL=https://healthidsbx.abdm.gov.in/api
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret

# ---- Redis (Session/Cache) ----
REDIS_URL=redis://localhost:6379
